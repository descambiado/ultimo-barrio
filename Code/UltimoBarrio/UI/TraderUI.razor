@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace UltimoBarrio.UI
@attribute [StyleSheet]

<root class="@(IsOpen ? "visible" : "")">
    <div class="trader-window">
        <div class="header">
            <label class="title">COMERCIANTE DEL BARRIO</label>
            <button class="close-btn" onclick=@Close>X</button>
        </div>
        <div class="content">
            <div class="buy-section">
                <label class="section-title">COMPRAR</label>
                <div class="item">
                    <label>Agua — $@TargetTrader?.WaterPrice</label>
                    <button class="action-btn" onclick=@(() => Buy("water"))>Comprar</button>
                </div>
                <div class="item">
                    <label>Medicina — $@TargetTrader?.MedicinePrice</label>
                    <button class="action-btn" onclick=@(() => Buy("medicine"))>Comprar</button>
                </div>
                <div class="item">
                    <label>Munición 9mm x12 — $@TargetTrader?.AmmoPrice</label>
                    <button class="action-btn" onclick=@(() => Buy("ammo_9mm"))>Comprar</button>
                </div>
                <div class="item">
                    <label>Pistola USP — $100</label>
                    <button class="action-btn" onclick=@(() => Buy("weapon_usp"))>Comprar</button>
                </div>
            </div>
            
            <div class="sell-section">
                <label class="section-title">VENDER CHATARRA</label>
                <div class="item">
                    <label>Chatarra — $@TargetTrader?.ScrapSellPrice / u</label>
                    <button class="action-btn sell" onclick=@(() => SellOne("chatarra"))>Vender 1</button>
                    <button class="action-btn sell" onclick=@(() => SellAll("chatarra"))>Vender todo</button>
                </div>
            </div>
        </div>
    </div>
</root>
