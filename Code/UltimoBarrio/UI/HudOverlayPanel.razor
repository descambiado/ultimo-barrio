@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace UltimoBarrio.UI
@attribute [StyleSheet]

<root>
    <div class="top-bar">
        <div class="phase-info">
            <label class="phase-name">@CurrentPhaseName</label>
            <label class="phase-timer">@TimeRemaining</label>
        </div>
        <div class="raid-status @(IsRaidActive ? "active" : "inactive")">
            <label>@RaidText</label>
        </div>
        <div class="apartment-status">
            <label>@ApartmentText</label>
        </div>
    </div>

    <div class="crosshair @(HasWeapon || IsReloading ? "" : "hidden")">
        <div class="crosshair-dot"></div>
    </div>

    <div class="feedback-feed">
        @foreach (var message in FeedbackMessages)
        {
            <div class="feedback-item">@message</div>
        }
    </div>

    <div class="bottom-bar">
        <div class="health-block">
            <div class="bar health-bar">
                <div class="bar-fill" style="width: @(HealthPercent * 100)%"></div>
            </div>
            <label class="health-value">@HealthText</label>
            <label class="health-label">VIDA</label>
        </div>

        <div class="stamina-block @(IsExhausted ? "exhausted" : "")">
            <div class="bar stamina-bar">
                <div class="bar-fill" style="width: @(StaminaPercent * 100)%"></div>
            </div>
            <label class="stamina-value">@StaminaText</label>
            <label class="stamina-label">RESISTENCIA</label>
        </div>

        <div class="weapon-block">
            <label class="weapon-name">@ActiveItemText</label>
            <label class="ammo-value @(LowMag ? "low" : "")">
                @if (HasWeapon)
                {
                    <text>@MagText / @MaxMagText</text>
                }
                else
                {
                    <text>--</text>
                }
            </label>
            <label class="reserve-label">RESERVA: @ReserveText</label>
            @if (IsReloading)
            {
                <label class="reload-label">RECARGANDO...</label>
            }
        </div>

        <div class="money-block">
            <label class="money-value">@MoneyText</label>
            <label class="money-label">FONDOS</label>
        </div>
    </div>

    <div class="mission-panel @(HasActiveMission ? "visible" : "hidden")">
        <label class="mission-title">@MissionTitle</label>
        @foreach (var objective in MissionObjectives)
        {
            <label class="mission-objective">@objective</label>
        }
    </div>
</root>
